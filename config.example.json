{
  "taskTimeoutSeconds": 1200,
  "linterMode": "required",
  "maxRepairAttempts": 3,
  "refactorAgent": {
    "command": [
      "node",
      "{backend_root}/dist/gate.js",
      "refactor",
      "--task-dir",
      "{task_dir}",
      "--source-root",
      "{harmony_root}",
      "--deveco",
      "deveco"
    ],
    "cwd": "{task_dir}",
    "timeoutSeconds": 1200,
    "blockedOutputRegex": "GATE_BLOCKED|rate limit|service.*overloaded"
  },
  "repairAgent": {
    "command": [
      "node",
      "{backend_root}/dist/gate.js",
      "refactor",
      "--task-dir",
      "{task_dir}",
      "--source-root",
      "{harmony_root}",
      "--deveco",
      "deveco",
      "--prompt-file",
      "{repair_prompt_file}"
    ],
    "cwd": "{task_dir}",
    "timeoutSeconds": 1200,
    "blockedOutputRegex": "GATE_BLOCKED|rate limit|service.*overloaded"
  },
  "gates": {
    "smell": {
      "command": [
        "node",
        "{backend_root}/dist/gate.js",
        "smell",
        "--task-dir",
        "{task_dir}",
        "--source-root",
        "{harmony_root}",
        "--homecheck-root",
        "REPLACE_WITH_HOMECHECK_ROOT"
      ],
      "cwd": "{task_dir}",
      "blockedOutputRegex": "SMELL_GATE_BLOCKED|GATE_BLOCKED"
    },
    "build": {
      "command": [
        "node",
        "{backend_root}/dist/gate.js",
        "hvigor",
        "--task-dir",
        "{task_dir}",
        "--source-root",
        "{harmony_root}",
        "--hvigorw",
        "hvigorw",
        "--ohpm",
        "ohpm",
        "--task",
        "assembleHap"
      ],
      "cwd": "{task_dir}",
      "blockedOutputRegex": "GATE_BLOCKED|Invalid storeFile value|Failed[^\\r\\n]*@SignHap|certificate|no devices"
    },
    "test": {
      "command": [
        "node",
        "{backend_root}/dist/gate.js",
        "hvigor",
        "--task-dir",
        "{task_dir}",
        "--source-root",
        "{harmony_root}",
        "--hvigorw",
        "hvigorw",
        "--ohpm",
        "ohpm",
        "--task",
        "auto-test"
      ],
      "cwd": "{task_dir}",
      "blockedOutputRegex": "TEST_GATE_BLOCKED|GATE_BLOCKED|Invalid storeFile value|no devices"
    },
    "linter": {
      "command": [
        "node",
        "{backend_root}/dist/gate.js",
        "linter",
        "--task-dir",
        "{task_dir}",
        "--source-root",
        "{harmony_root}",
        "--codelinter",
        "codelinter"
      ],
      "cwd": "{task_dir}",
      "blockedOutputRegex": "GATE_BLOCKED"
    }
  },
  "reviewAgent": {
    "command": [
      "node",
      "{backend_root}/dist/gate.js",
      "review",
      "--task-dir",
      "{task_dir}",
      "--deveco",
      "deveco",
      "--prompt-file",
      "{review_prompt_file}"
    ],
    "cwd": "{task_dir}",
    "blockedOutputRegex": "REVIEW_PACKET_BLOCKED|GATE_BLOCKED|product agreements|deveco auth consent|rate limit|service.*overloaded",
    "blockedOutputScope": "agent-errors",
    "timeoutSeconds": 1200
  },
  "reviewFormatAgent": {
    "command": [
      "node",
      "{backend_root}/dist/gate.js",
      "review",
      "--task-dir",
      "{task_dir}",
      "--deveco",
      "deveco",
      "--prompt-file",
      "{review_format_prompt_file}",
      "--format-only"
    ],
    "cwd": "{task_dir}",
    "blockedOutputRegex": "GATE_BLOCKED|product agreements|deveco auth consent|rate limit|service.*overloaded",
    "blockedOutputScope": "agent-errors",
    "timeoutSeconds": 90
  }
}
